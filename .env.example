# Copy to .env (it is gitignored) and fill in. Never commit real values.
WIFI_SSID=
WIFI_PASSWORD=

# Account used by the tests (registered automatically if the device has no profile yet).
# Login: 3-16 chars a-zA-Z0-9_, password: 6-32 chars.
SWM_LOGIN=
SWM_PASSWORD=

# Distance in cm of the static target in front of the sensor (for tests marked "target").
# Leave empty to skip those tests.
SWM_TARGET_CM=
